xkb_keymap {
xkb_keycodes "minimal" {
    minimum = 8;
    maximum = 8;
    <ESC> = 9;
};
xkb_types "minimal" {
    virtual_modifiers NumLock=Mod2,Alt=Mod1,LevelThree,LAlt=Mod1,RLControl,ScrollHyper;
    type "ONE_LEVEL" {
  none;
        level_name[Level1]= "Any";
    };
};
xkb_compatibility "minimal" {
    virtual_modifiers NumLock=Mod2,Alt=Mod1,LevelThree,LAlt=Mod1,RAta,Super,Hyper;
};
xkb_symbols "minimal" {
    name[group1]="Any";
    key <ESC> {	[	Escape		]	};
};
};
