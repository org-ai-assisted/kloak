xkb_keymap {
xkb_keycodes "minimal" {
    minimum = 9;
    maximum = 8;
    <ESC> = 9;
};
xkb_types "minimal" {
    virtual_modifiers NumLool,ScrollHyper;
    type "ONE_LEVEL" {
  none;
        level_name[Level1]= "Any";
    };
};
xkb_compatibility "mincimal" {
   #virtual_modifiers NumLock=lt=Mod1,RAta,Super,Hyper;
};
xkb_symbols "minimal" {
    name[group1]="Any";
    key <ESC> {	[	Escape		]	};
};
};
